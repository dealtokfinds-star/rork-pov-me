-- POVMe Backend Environment Variables
-- Copy this file to .env and fill in your values.
-- For Supabase Edge Functions, set these in the Supabase dashboard or via `supabase secrets set`.

# ─── Supabase ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Payment Provider ───
# Toggle between "lemonsqueezy" (Merchant of Record) or "stripe" (direct Stripe Connect)
PAYMENT_PROVIDER=lemonsqueezy

# Lemon Squeezy (used when PAYMENT_PROVIDER=lemonsqueezy)
LEMONSQUEEZY_API_KEY=0123456789abcdef...
LEMONSQUEEZY_STORE_ID=12345
LEMONSQUEEZY_WEBHOOK_SECRET=whsec_...

# Stripe (used when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Mux (Video & Live Streaming) ───
MUX_TOKEN_ID=abc123...
MUX_TOKEN_SECRET=def456...
MUX_WEBHOOK_SECRET=whsec_...

# ─── Email (Resend) ───
RESEND_API_KEY=re_...

# ─── KYC / Creator Verification ───
# When true, submit-kyc auto-approves creators. When false, creators go to a pending review queue.
KYC_AUTO_APPROVE=true

# ─── Expo Public Vars (also set in expo/.env) ───
EXPO_PUBLIC_PROJECT_ID=your-project-id
EXPO_PUBLIC_RORK_API_BASE_URL=https://api.rork.com
EXPO_PUBLIC_RORK_APP_KEY=your-app-key
EXPO_PUBLIC_RORK_AUTH_URL=https://api.rork.com
EXPO_PUBLIC_RORK_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1
EXPO_PUBLIC_RORK_TOOLKIT_SECRET_KEY=...
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
EXPO_PUBLIC_TEAM_ID=your-team-id
EXPO_PUBLIC_TOOLKIT_URL=https://toolkit.rork.com
